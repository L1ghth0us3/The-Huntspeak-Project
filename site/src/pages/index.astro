---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Huntspeak" current="home">
  <section class="hero">
    <div class="hero__moon" aria-hidden="true"></div>
    <h1 class="hero__brand">Huntspeak</h1>
    <p class="hero__lead">
      A speakable language for Miqo'te roleplay and storytelling — built by the community
      from the small official scraps Final Fantasy XIV gives us.
    </p>
    <p class="hero__sample hs">
      Shîmakh! Naish su buvar?
      <span>Hello! How are you doing?</span>
    </p>
    <div class="hero__ctas">
      <a class="btn btn-primary" href={withBase('/learn/')}>Start learning</a>
      <a class="btn btn-ghost" href={withBase('/phrasebook/')}>Say something</a>
      <a class="btn btn-ghost" href={withBase('/dictionary/')}>Look up a word</a>
    </div>
  </section>
</BaseLayout>
