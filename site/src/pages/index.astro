---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="The Huntspeak Project" current="home">
  <section class="hero">
    <div class="hero__sky" aria-hidden="true">
      <div class="hero__moon"></div>
    </div>
    <div class="hero__content">
      <h1 class="hero__brand">The Huntspeak Project</h1>
      <p class="hero__lead">
        A community home for Huntspeak - a speakable language for Miqo'te roleplay and storytelling,
        grown from the small official scraps Final Fantasy XIV gives us.
      </p>
      <p class="hero__sample hs">
        Shîmakh! Naish su buvar?
        <span>Hello! How are you doing?</span>
      </p>
      <div class="hero__ctas">
        <a class="btn btn-primary" href={withBase('/learn/')}>Start learning</a>
        <a class="btn btn-ghost" href={withBase('/phrasebook/')}>Say something</a>
        <a class="btn btn-ghost" href={withBase('/dictionary/')}>Look up a word</a>
        <a class="btn btn-ghost" href="https://discord.gg/bG9dGBHFtS" rel="noopener noreferrer">
          Join Discord
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
